# Shell scripts must use LF line endings (for Linux containers)
*.sh text eol=lf

# TypeScript/JavaScript files
*.ts text eol=lf
*.js text eol=lf
*.json text eol=lf

# Go files
*.go text eol=lf
*.mod text eol=lf
*.sum text eol=lf

# SQL files
*.sql text eol=lf

# Markdown and documentation
*.md text eol=lf

# YAML files
*.yaml text eol=lf
*.yml text eol=lf

# Config files
.gitignore text eol=lf
.gitattributes text eol=lf
